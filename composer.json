{
    "name": "euginepj/laravel-api-specs",
    "description": "Interactive, modern 2-column REST API documentation portal for Laravel applications",
    "license": "MIT",
    "authors": [
        {
            "name": "Eugine",
            "email": "eugin@cloudtech.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Euginepj\\ApiSpecs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Euginepj\\ApiSpecs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Euginepj\\ApiSpecs\\ApiSpecsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
